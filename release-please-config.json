{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "rust",
      "package-name": "ytdown",
      "extra-files": ["ytdown-py/Cargo.toml"]
    },
    "cli": {
      "release-type": "rust",
      "package-name": "ytdown-cli"
    },
    "web": {
      "release-type": "node",
      "package-name": "@4thel00z/ytdown"
    }
  },
  "plugins": ["cargo-workspace"]
}
