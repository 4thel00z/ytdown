{
  "name": "@4thel00z/ytdown",
  "version": "0.5.0",
  "description": "Resolve and download YouTube media from the browser (WASM core).",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../ytdown-wasm --target web --out-dir ../web/wasm",
    "build": "bun run build:wasm && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/4thel00z/ytdown.git"
  },
  "keywords": [
    "youtube",
    "download",
    "wasm",
    "browser",
    "yt-dlp"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "jsdom": "^24.0.0"
  }
}
